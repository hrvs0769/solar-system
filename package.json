{
  "name": "solar-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "3D solar system teaching app (browser, offline-capable)",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build",
    "build:offline": "vite build --config vite.config.offline.js",
    "preview": "vite preview",
    "serve": "node scripts/serve.js",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:mobile": "node scripts/mobile-check.mjs",
    "test:all": "npm run build:offline && node --test \"tests/*.test.mjs\" && node scripts/e2e.mjs && node scripts/mobile-check.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "qrcode": "^1.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.9.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
